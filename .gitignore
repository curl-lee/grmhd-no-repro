# Stage AI publishes lightweight configs, logs, metrics, reports, and figures.
# Global checkpoint/data patterns above continue to exclude binary training state.

# Stage AG publication keeps formal summaries plus best/last checkpoints, but
# excludes reproducible fixed-epoch/resume states and the 1.06 GB prediction cache.
artifacts/stage_ag/raw_validation_predictions/*.npz
artifacts/stage_ag/training/checkpoints/epoch_*.pt
artifacts/stage_ag/training/resume.pt
artifacts/stage_ag/training_console.log
